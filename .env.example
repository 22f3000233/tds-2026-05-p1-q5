# Copy this file to .env and fill in real values before running locally,
# and set the same variables on your host before deploying.

# From @BotFather on Telegram, after you create your bot.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# The public HTTPS URL your app is reachable at once deployed, no trailing
# slash (e.g. https://your-subdomain.example). The bot reaches OUT to
# Telegram (long-polling) rather than needing Telegram to reach in, so this
# is used for exactly one thing: building the log_url in every reply — but
# GET /logs/run.jsonl still has to be a real public URL per the assignment,
# so you still need a real domain + HTTPS in front of this app.
PUBLIC_BASE_URL=https://your-deployed-host

# Google AI Studio (https://aistudio.google.com/apikey) key, used through
# Gemini's OpenAI-compatible endpoint. A plain key that doesn't expire on a
# timer (unlike AI Pipe's ~7-day JWTs), so it survives an unknown grading
# date. Set LLM_API_KEY + LLM_BASE_URL instead if you'd rather use a
# different OpenAI-compatible provider.
# Without a key the bot still runs and replies, but every answer comes back
# null with an honest "no LLM configured" note in the log instead of a real
# computed answer.
#
# IMPORTANT: a key from a Google Cloud project with NO billing account
# linked has a free-tier request quota of literally 0 (every call 429s with
# "generate_content_free_tier_requests, limit: 0"), not a small-but-nonzero
# limit. Link the project to a billing account (a Google Cloud free-trial
# credit works fine) before relying on this key for anything, and confirm
# with one real curl call — 429s here look identical to "the model gave a
# bad answer" in the bot's replies, since the code still answers 200/null.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated, tried in order — first model that answers wins, so a
# quota hit or outage on one doesn't sink the run. Ordered by capability
# (Pro tier excluded — it didn't appear on this project's free-tier quota
# dashboard, so treat it as unusable there until proven otherwise), then
# falls through to higher-daily-quota Flash-Lite models so a low RPD cap
# on one model doesn't stall a whole run. gemini-2.5-flash was previously
# observed 404ing on this OpenAI-compatible route despite being listed
# (2026-07-27) — left in since the loop just falls through on failure.
LLM_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest,gemini-2.0-flash-lite

# Optional: comma-separated Telegram numeric user IDs allowed to talk to the
# bot. Leave empty while testing (anyone can message it); once you know the
# grading account's user ID, add it here so the bot ignores everyone else -
# see README.md's Security section for how to find that ID.
ALLOWED_TELEGRAM_USER_IDS=

# Optional tuning.
AGENT_MAX_STEPS=8
AGENT_STEP_TIMEOUT=20
# Wall-clock seconds for the whole tool-calling loop, independent of step
# count - past this, run_python stops being offered and the model is
# nudged to answer with whatever it has instead of running out the step
# budget into a null reply.
AGENT_TIME_BUDGET_SECONDS=90
